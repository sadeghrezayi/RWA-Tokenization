generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy (OD-1a): single-tenant install on a tenant-ready schema. Every
// tenant-owned row carries tenant_id (FK to tenants). Scoping is enforced by
// the composition root (TenantContext + scoped Prisma extension), never
// trusted from client input. The "default" tenant is seeded by migration.
// ---------------------------------------------------------------------------

model Tenant {
  id        String   @id
  name      String
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")

  organizations          Organization[]
  tokenTransfers         TokenTransfer[]
  redemptions            Redemption[]
  attestations           Attestation[]
  assets                 Asset[]
  assetDocuments         AssetDocument[]
  assetEvents            AssetEvent[]
  distributions          Distribution[]
  distributionPayouts    DistributionPayout[]
  offerings              Offering[]
  offeringSubscriptions  OfferingSubscription[]
  offeringAllocations    OfferingAllocation[]
  ledgerAccounts         LedgerAccount[]
  ledgerEntries          LedgerEntry[]
  investorWallets        InvestorWallet[]
  investors              Investor[]
  onchainIdentities      OnchainIdentity[]
  crmProfiles            CrmProfile[]
  crmNotes               CrmNote[]
  crmFollowUps           CrmFollowUp[]
  approvals              Approval[]
  notifications          Notification[]
  onboardingApplications OnboardingApplication[]
  kycEvidence            KycEvidence[]
  onboardingAnswers      OnboardingAnswer[]
  fundingRequests        FundingRequest[]
  assetRights            AssetRight[]
  issuerOrganisations    IssuerOrganisation[]
  issuerMemberships      IssuerMembership[]

  screeningResults ScreeningResult[]
  riskAssessments  RiskAssessment[]
  @@map("tenants")
}

// Organizations under a tenant: the platform operator itself, issuers, asset
// owners, and service providers. Lifecycle/workflow arrives with the issuer
// portal (Phase 3); the table exists now for schema stability.
model Organization {
  id        String   @id
  tenantId  String   @default("default") @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  type      String
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("organizations")
}

// T4 self-service recovery: single-use password-reset tokens. Only the SHA-256
// hash of the token is stored (a DB leak yields no usable reset link).
// Platform-level (pre-auth flow), so not tenant-scoped.
model PasswordResetToken {
  tokenHash  String    @id @map("token_hash")
  investorId String    @map("investor_id")
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([investorId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  tokenHash  String    @id @map("token_hash")
  investorId String    @map("investor_id")
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([investorId])
  @@map("email_verification_tokens")
}

// Staff/operator accounts (1.4c). Platform-level (not tenant-scoped) — evaluated
// pre-auth during login. Roles are granted via StaffMembership.
model StaffUser {
  id           String            @id
  email        String            @unique
  passwordHash String            @map("password_hash")
  status       String            @default("active")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  memberships  StaffMembership[]

  @@map("staff_users")
}

model StaffMembership {
  userId String    @map("user_id")
  user   StaffUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   String

  @@id([userId, role])
  @@map("staff_memberships")
}

// T1/T3 maker-checker: a sensitive action awaiting a second person's decision.
// Tenant-owned. payload holds the action parameters (e.g. ledger.credit →
// { investorId, amountRial }).
model Approval {
  id        String    @id
  tenantId  String    @default("default") @map("tenant_id")
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  action    String
  payload   Json
  makerId   String    @map("maker_id")
  status    String
  checkerId String?   @map("checker_id")
  reason    String?
  createdAt DateTime  @default(now()) @map("created_at")
  decidedAt DateTime? @map("decided_at")

  @@index([tenantId, status])
  @@map("approvals")
}

// T1/T4 MFA enrollment, keyed by principal id (officer id today; staff/user id
// after 1.4). Platform-level, not tenant-scoped. The TOTP secret is stored
// reversibly (must verify codes) — encryption-at-rest is a T14/Phase-8 item.
model MfaEnrollment {
  principalId        String   @id @map("principal_id")
  secret             String
  status             String
  recoveryCodeHashes String[] @map("recovery_code_hashes")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("mfa_enrollments")
}

// T4 account lockout: per-identifier failed-login state. Platform-level
// (security infrastructure, evaluated pre-authentication) — deliberately NOT
// tenant-scoped; the key is the normalized login identifier.
model LoginAttempt {
  key             String    @id
  failures        Int       @default(0)
  windowStartedAt DateTime? @map("window_started_at")
  lockedUntil     DateTime? @map("locked_until")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("login_attempts")
}

enum KycState {
  draft
  submitted
  in_review
  approved
  rejected
  expired
}

enum AssetState {
  proposed
  in_structuring
  approved
  tokenized
  suspended
  retired
}

// FR-TR-1: executed compliant transfers (feeds the holder registry + history).
model TokenTransfer {
  id             String   @id
  tenantId       String   @default("default") @map("tenant_id")
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  assetId        String   @map("asset_id")
  tokenAddress   String   @map("token_address")
  fromInvestorId String   @map("from_investor_id")
  toInvestorId   String   @map("to_investor_id")
  tokens         BigInt
  executedAt     DateTime @map("executed_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([assetId])
  @@index([fromInvestorId])
  @@index([toInvestorId])
  @@map("token_transfers")
}

enum RedemptionState {
  requested
  fulfilled
  rejected
}

// FR-TR-2: redemption requests and their resolution at attested value.
model Redemption {
  id              String          @id
  tenantId        String          @default("default") @map("tenant_id")
  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  assetId         String          @map("asset_id")
  tokenAddress    String          @map("token_address")
  investorId      String          @map("investor_id")
  tokens          BigInt
  state           RedemptionState
  requestedAt     DateTime        @map("requested_at")
  payoutRial      BigInt?         @map("payout_rial")
  rejectionReason String?         @map("rejection_reason")
  resolvedAt      DateTime?       @map("resolved_at")
  createdAt       DateTime        @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([investorId])
  @@map("redemptions")
}

enum AttestationKind {
  valuation
  nav
  rent
  reserve
}

// FR-OR: signed real-world facts about an asset, hash anchored on-chain.
model Attestation {
  id          String          @id
  tenantId    String          @default("default") @map("tenant_id")
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  assetId     String          @map("asset_id")
  kind        AttestationKind
  valueRial   BigInt          @map("value_rial")
  attestorId  String          @map("attestor_id")
  issuedAt    DateTime        @map("issued_at")
  validUntil  DateTime        @map("valid_until")
  payloadHash String          @map("payload_hash")
  signature   String
  documentCid String?         @map("document_cid")
  createdAt   DateTime        @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([assetId, kind, issuedAt])
  @@map("attestations")
}

model Asset {
  id               String              @id
  tenantId         String              @default("default") @map("tenant_id")
  tenant           Tenant              @relation(fields: [tenantId], references: [id])
  name             String
  type             String
  state            AssetState
  custodianName    String?             @map("custodian_name")
  custodyLocation  String?             @map("custody_location")
  tokenAddress     String?             @map("token_address")
  checklist        String[]
  documents        AssetDocument[]
  // 3.1: the property a real-estate token is issued against. Nullable because
  // not every asset is a building — an asset with no profile has simply not
  // had one recorded.
  addressLine      String?             @map("address_line")
  city             String?
  propertyType     String?             @map("property_type")
  areaSquareMetres Int?                @map("area_square_metres")
  titleReference   String?             @map("title_reference")
  builtInYear      Int?                @map("built_in_year")
  // 3.3: the issuer organisation that brought this asset. NULLABLE ON PURPOSE —
  // the platform onboards assets itself and every pilot asset was staff-
  // onboarded, so NULL means "the platform", not "not yet filled in".
  organisationId   String?             @map("organisation_id")
  organisation     IssuerOrganisation? @relation(fields: [organisationId], references: [id])
  rights           AssetRight[]
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([organisationId])
  @@map("assets")
}

// 3.1: what the token conveys, one row per right, carrying the wording it was
// granted in. A right absent from this table is NOT conveyed — and an asset
// with no rows has had nothing established, which is a different statement.
model AssetRight {
  id        String   @id @default(uuid())
  tenantId  String   @default("default") @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  assetId   String   @map("asset_id")
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  kind      String
  note      String
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([assetId, kind])
  @@index([tenantId])
  @@map("asset_rights")
}

model AssetDocument {
  id              String   @id @default(uuid())
  tenantId        String   @default("default") @map("tenant_id")
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  assetId         String   @map("asset_id")
  asset           Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  kind            String
  title           String
  cid             String
  sha256          String
  // Disclosure is opt-in: a document is invisible to holders until an operator
  // deliberately reveals it (2.5d).
  investorVisible Boolean  @default(false) @map("investor_visible")
  // 4.3: whether a person has actually read this document. Existing rows
  // default to "pending" — nobody reviewed them, and saying otherwise would
  // backdate approvals that were granted before the gate existed.
  reviewState     String   @default("pending") @map("review_state")
  reviewedBy      String?  @map("reviewed_by")
  reviewedAt      DateTime? @map("reviewed_at")
  reviewReason    String?  @map("review_reason")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("asset_documents")
}

// FR-AO-5 / seed of FR-RA-2: append-only audit trail of asset actions.
model AssetEvent {
  id        BigInt   @id @default(autoincrement())
  tenantId  String   @default("default") @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  assetId   String   @map("asset_id")
  event     String
  actor     String
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("asset_events")
}

enum DistributionState {
  declared
  paid
}

model Distribution {
  id              String               @id
  tenantId        String               @default("default") @map("tenant_id")
  tenant          Tenant               @relation(fields: [tenantId], references: [id])
  assetId         String               @map("asset_id")
  tokenAddress    String               @map("token_address")
  totalAmountRial BigInt               @map("total_amount_rial")
  state           DistributionState
  // Set when the distribution is actually paid, so a holder's income can be
  // dated. Null for anything not yet paid (and for rows written before 2.5a).
  paidAt          DateTime?            @map("paid_at")
  payouts         DistributionPayout[]
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("distributions")
}

model DistributionPayout {
  id             BigInt       @id @default(autoincrement())
  tenantId       String       @default("default") @map("tenant_id")
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  distributionId String       @map("distribution_id")
  distribution   Distribution @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  investorId     String       @map("investor_id")
  tokens         BigInt
  amountRial     BigInt       @map("amount_rial")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("distribution_payouts")
}

enum OfferingState {
  draft
  open
  closed_success
  closed_failed
}

model Offering {
  id             String                 @id
  tenantId       String                 @default("default") @map("tenant_id")
  tenant         Tenant                 @relation(fields: [tenantId], references: [id])
  assetId        String                 @map("asset_id")
  tokenAddress   String                 @map("token_address")
  supply         BigInt
  priceRial      BigInt                 @map("price_rial")
  minPerInvestor BigInt                 @map("min_per_investor")
  maxPerInvestor BigInt                 @map("max_per_investor")
  minimumRaise   BigInt                 @map("minimum_raise")
  opensAt        DateTime               @map("opens_at")
  closesAt       DateTime               @map("closes_at")
  state          OfferingState
  // 2.1a (OD-5): when this offering was deliberately published to the public
  // catalog. NULL = never published. Distinct from `state` — an offering can be
  // open to invited investors without being advertised publicly.
  publishedAt    DateTime?              @map("published_at")
  subscriptions  OfferingSubscription[]
  allocations    OfferingAllocation[]
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("offerings")
}

model OfferingSubscription {
  id         BigInt   @id @default(autoincrement())
  tenantId   String   @default("default") @map("tenant_id")
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  offeringId String   @map("offering_id")
  offering   Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  investorId String   @map("investor_id")
  tokens     BigInt
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("offering_subscriptions")
}

model OfferingAllocation {
  id         BigInt   @id @default(autoincrement())
  tenantId   String   @default("default") @map("tenant_id")
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  offeringId String   @map("offering_id")
  offering   Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  investorId String   @map("investor_id")
  requested  BigInt
  allocated  BigInt
  costRial   BigInt   @map("cost_rial")
  refundRial BigInt   @map("refund_rial")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("offering_allocations")
}

// D3: off-chain Rial ledger. Balance columns are the fast path; the
// append-only entries are the auditable record (NFR-2).
model LedgerAccount {
  investorId String   @id @map("investor_id")
  tenantId   String   @default("default") @map("tenant_id")
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  balance    BigInt   @default(0)
  held       BigInt   @default(0)
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("ledger_accounts")
}

model LedgerEntry {
  id         BigInt   @id @default(autoincrement())
  tenantId   String   @default("default") @map("tenant_id")
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  investorId String   @map("investor_id")
  kind       String
  amountRial BigInt   @map("amount_rial")
  actor      String
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("ledger_entries")
}

// FR-CU-1 custodial wallets: HD-derived per investor from the platform key.
// Addresses stay globally unique (chain reality); derivation index is global.
model InvestorWallet {
  derivationIndex Int    @id @default(autoincrement()) @map("derivation_index")
  tenantId        String @default("default") @map("tenant_id")
  tenant          Tenant @relation(fields: [tenantId], references: [id])
  investorId      String @unique @map("investor_id")
  address         String @unique

  @@index([tenantId])
  @@map("investor_wallets")
}

model Investor {
  id                 String           @id
  tenantId           String           @default("default") @map("tenant_id")
  tenant             Tenant           @relation(fields: [tenantId], references: [id])
  email              String
  passwordHash       String           @map("password_hash")
  emailVerified      Boolean          @default(false) @map("email_verified")
  kycState           KycState         @map("kyc_state")
  kycRejectionReason String?          @map("kyc_rejection_reason")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  onchainIdentity    OnchainIdentity?

  screeningResults ScreeningResult[]
  riskAssessments  RiskAssessment[]
  @@unique([tenantId, email])
  @@map("investors")
}

// Adapter-owned mapping: which ONCHAINID identity contract belongs to which
// investor. Chain-infrastructure detail, deliberately outside the domain model.
model OnchainIdentity {
  investorId String   @id @map("investor_id")
  tenantId   String   @default("default") @map("tenant_id")
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  address    String   @unique
  createdAt  DateTime @default(now()) @map("created_at")
  investor   Investor @relation(fields: [investorId], references: [id])

  @@index([tenantId])
  @@map("onchain_identities")
}

model CrmProfile {
  investorId String   @id @map("investor_id")
  tenantId   String   @default("default") @map("tenant_id")
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  stage      String
  tags       String[]
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("crm_profiles")
}

model CrmNote {
  id         String   @id
  tenantId   String   @default("default") @map("tenant_id")
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  investorId String   @map("investor_id")
  authorId   String   @map("author_id")
  text       String
  createdAt  DateTime @map("created_at")

  @@index([tenantId])
  @@map("crm_notes")
}

model CrmFollowUp {
  id            String    @id
  tenantId      String    @default("default") @map("tenant_id")
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  investorId    String    @map("investor_id")
  text          String
  dueAt         DateTime  @map("due_at")
  state         String
  doneAt        DateTime? @map("done_at")
  // 1.7d: when the overdue reminder was announced (null = not yet), so the
  // scheduled scan never repeats a reminder.
  dueNotifiedAt DateTime? @map("due_notified_at")
  createdAt     DateTime  @map("created_at")

  @@index([tenantId])
  @@map("crm_follow_ups")
}

// ---------------------------------------------------------------------------
// Transactional outbox (1.6b): durable at-least-once side effects (today, the
// auth emails). A producer writes a row in the SAME transaction as its state
// change; a drainer delivers it with retry/backoff and dead-letters after the
// attempt budget. Platform-level (no tenant_id) — the background drainer runs
// without a TenantContext; a message payload carries any context a handler
// needs. In UNSCOPED_MODELS.
model OutboxMessage {
  id          String   @id
  type        String
  payload     Json
  status      String   @default("pending")
  attempts    Int      @default(0)
  availableAt DateTime @default(now()) @map("available_at")
  lastError   String?  @map("last_error")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([status, availableAt])
  @@map("outbox_messages")
}

// In-app notifications (1.7). Tenant-owned; addressed to one recipient (staff or
// investor). createdAt is set by the domain (not a DB default) so ordering is
// deterministic in tests. Read state is a nullable timestamp.
model Notification {
  id            String    @id
  tenantId      String    @default("default") @map("tenant_id")
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  recipientKind String    @map("recipient_kind")
  recipientId   String    @map("recipient_id")
  type          String
  title         String
  body          String
  readAt        DateTime? @map("read_at")
  createdAt     DateTime  @map("created_at")

  @@index([tenantId, recipientKind, recipientId, createdAt])
  @@map("notifications")
}

// 2.3a: the evidence-collection lifecycle for an investor's onboarding.
// Tenant-owned. Deliberately separate from Investor.kycState, which remains the
// authority on whether the investor is approved.
model OnboardingApplication {
  id             String    @id
  tenantId       String    @default("default") @map("tenant_id")
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  investorId     String    @unique @map("investor_id")
  kind           String
  status         String
  completedSteps String[]  @map("completed_steps")
  changeRequests Json      @map("change_requests")
  startedAt      DateTime  @map("started_at")
  submittedAt    DateTime? @map("submitted_at")

  @@index([tenantId, status])
  @@map("onboarding_applications")
}

// 2.3b: identity evidence, ENCRYPTED AT REST (AES-256-GCM) — deliberately NOT
// IPFS, because personal data must be erasable and must not be fetchable by
// anyone holding a content address. `content` holds the sealed blob only; no
// plaintext of the document is stored anywhere in this table.
model KycEvidence {
  reference   String   @id
  tenantId    String   @default("default") @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  investorId  String   @map("investor_id")
  step        String
  filename    String
  contentType String   @map("content_type")
  byteSize    Int      @map("byte_size")
  content     Bytes
  uploadedAt  DateTime @map("uploaded_at")

  @@index([tenantId, investorId])
  @@map("kyc_evidence")
}

// 2.3e: the applicant's typed answers, ENCRYPTED AT REST like the documents.
// One row per (investor, step) so a step can be re-answered without a
// read-modify-write over everything else. `content` holds the sealed JSON.
model OnboardingAnswer {
  id         String   @id
  tenantId   String   @default("default") @map("tenant_id")
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  investorId String   @map("investor_id")
  step       String
  content    Bytes
  updatedAt  DateTime @map("updated_at")

  @@unique([tenantId, investorId, step])
  @@index([tenantId, investorId])
  @@map("onboarding_answers")
}

// 2.4 / OD-6: money enters as a bank transfer that treasury confirms.
// `amount_rial` is what the investor declared they would send; `settled_amount_rial`
// is what actually arrived and was credited — a bank credits what was really
// sent, and conflating the two would put the ledger out of step with the
// statement. Every settled state is terminal, which is what stops a deposit
// being credited twice.
model FundingRequest {
  id                String    @id
  tenantId          String    @default("default") @map("tenant_id")
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  investorId        String    @map("investor_id")
  amountRial        BigInt    @map("amount_rial")
  reference         String
  status            String
  requestedAt       DateTime  @map("requested_at")
  settledAt         DateTime? @map("settled_at")
  settledAmountRial BigInt?   @map("settled_amount_rial")
  rejectionReason   String?   @map("rejection_reason")

  @@unique([tenantId, reference])
  @@index([tenantId, status])
  @@index([tenantId, investorId])
  @@map("funding_requests")
}

// 3.2: the legal entity that brings assets to the platform. It applies, a
// person reviews it, and only then may it do anything — the default is never
// "allowed to raise money from the public".
model IssuerOrganisation {
  id                 String             @id
  tenantId           String             @default("default") @map("tenant_id")
  tenant             Tenant             @relation(fields: [tenantId], references: [id])
  legalName          String             @map("legal_name")
  registrationNumber String             @map("registration_number")
  contactEmail       String             @map("contact_email")
  state              String
  appliedAt          DateTime           @map("applied_at")
  decidedAt          DateTime?          @map("decided_at")
  decidedBy          String?            @map("decided_by")
  rejectionReason    String?            @map("rejection_reason")
  members            IssuerMembership[]
  assets             Asset[]
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("issuer_organisations")
}

// A person acting for an organisation. One row per person per organisation:
// adding someone again changes their role rather than listing them twice.
model IssuerMembership {
  id             String             @id @default(uuid())
  tenantId       String             @default("default") @map("tenant_id")
  tenant         Tenant             @relation(fields: [tenantId], references: [id])
  organisationId String             @map("organisation_id")
  organisation   IssuerOrganisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  userId         String             @map("user_id")
  role           String
  addedAt        DateTime           @map("added_at")

  @@unique([organisationId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("issuer_memberships")
}

// 4.2: what a sanctions/PEP check said about one person at one moment.
//
// Append-only by intent: a re-run months later is a NEW fact, not a correction,
// so there is no unique key on investorId. `provider` and `simulated` are
// stored with the outcome because a result travels — into a report, into a
// regulator's hands — and must always be able to say what produced it. A row
// that says "clear" without saying who checked is a liability, not a record.
// A rating a person gave a file at one moment, with the answers behind it (4.2).
// Append-only: a re-rating is a new judgement, not an edit of the old one, and
// `band` is stored as DECIDED rather than recomputed — the thresholds are
// configuration and will be re-tuned.
model RiskAssessment {
  id         String   @id
  tenantId   String   @default("default") @map("tenant_id")
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  subjectId  String   @map("subject_id")
  investor   Investor @relation(fields: [subjectId], references: [id])
  answers    Json
  score      Int
  band       String
  assessedBy String   @map("assessed_by")
  assessedAt DateTime @map("assessed_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([subjectId])
  @@map("risk_assessments")
}

model ScreeningResult {
  id         String   @id
  tenantId   String   @default("default") @map("tenant_id")
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  subjectId  String   @map("subject_id")
  investor   Investor @relation(fields: [subjectId], references: [id])
  outcome    String
  provider   String
  simulated  Boolean
  checkedAt  DateTime @map("checked_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([subjectId])
  @@map("screening_results")
}
